# Spark Clipper settings.
# Copy this whole file to ".env" (same folder), paste your keys after the "=", and restart run.bat.
# Only ONE AI key is required. Everything else already has a good default.

# =====================================================================
# AI: finds the clips, rates them, writes titles / descriptions / hooks
# =====================================================================
# Gemini (free): https://aistudio.google.com/apikey
# Keys from DIFFERENT Google projects have separate free limits, so add as many as you have
# Put them all in ONE line, separated by commas:  GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=AIzaSyCtbALFVOOcb-fsNgRe1DCyNgI3cr2opZc,AIzaSyCC_N5S0awXKOdDhavqo_fhQ9R8s071_eg,AIzaSyD2njCrCw1pAsg2dockaUB_Lb9ngKPv-00,AIzaSyCGlOIrUTghvPewYrdObTuQgeUISsDXOfM,AIzaSyB-vxTrusYpwyzOJ2zBCC9PJw2AsdAVMBY,AIzaSyA1scP8rmysCEG2PZdFkldxxOH6n6H8hwg,AIzaSyCDWdUESw1jEJ5b5WXLlgLjt_Sq6OwJr6o,AIzaSyBNTrdGtvEjiNw3L3s8bfjpjj0qerSKU2A

# Models to try, fastest/most reliable first. If one is overloaded the next is used.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-flash-latest

# =====================================================================
# Backup AI providers (used automatically when Gemini hits its limit)
# =====================================================================
# Every provider takes one or many keys in ONE line, separated by commas:  GROQ_API_KEYS=key1,key2,key3
# When one key hits its limit the app moves to the next key, then to the next provider.
# Groq (free): https://console.groq.com/keys
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Grok (xAI): https://console.x.ai
XAI_API_KEYS=
# Cerebras (free): https://cloud.cerebras.ai
CEREBRAS_API_KEYS=
# OpenRouter (free models available): https://openrouter.ai/keys
OPENROUTER_API_KEYS=
# Mistral: https://console.mistral.ai
MISTRAL_API_KEYS=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEYS=
# Any other OpenAI-compatible service (optional), format: name|https://host/v1|api_key|model1,model2
# CUSTOM_LLM_1=
# Order the providers are tried in (default: gemini, groq, cerebras, xai, openrouter, mistral, openai, custom)
# LLM_ORDER=gemini,groq,xai

# =====================================================================
# Transcription
# =====================================================================
# 1 = use YouTube's own captions when the video has them (seconds instead of minutes). Whisper is the fallback.
USE_YT_CAPTIONS=1
# Whisper size when captions are missing: tiny | base | small | medium | large-v3 (bigger = slower, more accurate)
WHISPER_MODEL=small

# =====================================================================
# Performance and automation
# =====================================================================
# Videos processed at the same time. Each one is heavy on the CPU; the rest wait in line.
# 1 = gentle on a weak PC, 2 = default, 3-4 = strong PC.
JOB_WORKERS=2
# How often followed creators are checked for new videos (minutes)
WATCH_INTERVAL_MINUTES=15
# Hours after upload before an uploaded clip (and, once all clips are uploaded, the source video) is deleted to free space. 0 = keep everything.
AUTO_DELETE_HOURS=24

# =====================================================================
# Downloading
# =====================================================================
# If YouTube says "confirm you are not a bot", set this to chrome, edge or firefox
# to reuse that browser's YouTube login.
# YTDLP_COOKIES_BROWSER=chrome
